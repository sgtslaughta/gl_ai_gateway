   "locked": false,
   "fontSize": 20,
   "fontFamily": 2,
   "text": "\u2022 Identity unverified: ID token may not name the triggering user\n\u2022 Lowest flexibility: each new task needs central support\n\u2022 Code and reports concentrate in the central project\n\u2022 Findings likely miss the source MR, so review is weaker\n\u2022 Membership, job-token and central upkeep",
   "originalText": "\u2022 Identity unverified: ID token may not name the triggering user\n\u2022 Lowest flexibility: each new task needs central support\n\u2022 Code and reports concentrate in the central project\n\u2022 Findings likely miss the source MR, so review is weaker\n\u2022 Membership, job-token and central upkeep",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
