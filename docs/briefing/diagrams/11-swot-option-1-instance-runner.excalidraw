   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 20,
   "fontFamily": 2,
   "text": "\u2022 Best fit for 'any user': reaches all projects at once\n\u2022 Lowest operations: one runner ID in STS\n\u2022 No trust added beyond GitLab admins\n\u2022 Native code quality report on the MR\n\u2022 Users can write custom jobs, so flexibility is highest",
   "originalText": "\u2022 Best fit for 'any user': reaches all projects at once\n\u2022 Lowest operations: one runner ID in STS\n\u2022 No trust added beyond GitLab admins\n\u2022 Native code quality report on the MR\n\u2022 Users can write custom jobs, so flexibility is highest",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
