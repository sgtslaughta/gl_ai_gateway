   "fontSize": 20,
   "fontFamily": 2,
   "text": "\u2022 Any GitLab user can run code on the cluster, entitled or not\n\u2022 All hard controls must be complete before opening\n\u2022 A poisoned commit's job can request a token\n\u2022 Users control job YAML, so templates are only defaults",
   "originalText": "\u2022 Any GitLab user can run code on the cluster, entitled or not\n\u2022 All hard controls must be complete before opening\n\u2022 A poisoned commit's job can request a token\n\u2022 Users control job YAML, so templates are only defaults",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
