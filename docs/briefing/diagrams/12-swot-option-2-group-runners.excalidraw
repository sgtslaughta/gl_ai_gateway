   "fontSize": 20,
   "fontFamily": 2,
   "text": "\u2022 Each group Owner joins the trust boundary\n\u2022 One runner ID per group to track\n\u2022 Personal namespaces excluded\n\u2022 A poisoned commit's job can request a token\n\u2022 Users control job YAML, so templates are only defaults",
   "originalText": "\u2022 Each group Owner joins the trust boundary\n\u2022 One runner ID per group to track\n\u2022 Personal namespaces excluded\n\u2022 A poisoned commit's job can request a token\n\u2022 Users control job YAML, so templates are only defaults",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
