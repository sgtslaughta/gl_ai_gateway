   "fontSize": 20,
   "fontFamily": 2,
   "text": "\u2022 No GitLab admin needed\n\u2022 Cluster exposed only to onboarded group members\n\u2022 Gradual rollout limits early risk\n\u2022 Same identity and report path as option 1\n\u2022 STS rejects any runner not on the list",
   "originalText": "\u2022 No GitLab admin needed\n\u2022 Cluster exposed only to onboarded group members\n\u2022 Gradual rollout limits early risk\n\u2022 Same identity and report path as option 1\n\u2022 STS rejects any runner not on the list",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
