   "fontSize": 14,
   "fontFamily": 2,
   "text": "A gateway bug must not expose the STS signing key,\nso the two stay separate.",
   "originalText": "A gateway bug must not expose the STS signing key,\nso the two stay separate.",
   "textAlign": "left",
