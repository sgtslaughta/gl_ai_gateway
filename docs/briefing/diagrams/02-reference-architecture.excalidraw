   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 2,
   "text": "2-5  Job swaps its GitLab ID token for an STS token (aud = gateway, 30 min max, never past ID token exp).\n6  STS token never goes upstream. Provider honors X-Proxied-Entity only from the gateway certificate.\n7  Provider records can be joined on x-litellm-call-id for model and token use. No prompts or responses in any new component.",
   "originalText": "2-5  Job swaps its GitLab ID token for an STS token (aud = gateway, 30 min max, never past ID token exp).\n6  STS token never goes upstream. Provider honors X-Proxied-Entity only from the gateway certificate.\n7  Provider records can be joined on x-litellm-call-id for model and token use. No prompts or responses in any new component.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "02-reference-architecture-74",
   "type": "text",
   "x": 1090,
   "y": 1150,
   "width": 703.08,
   "height": 52.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 586006,
   "version": 1,
   "versionNonce": 7749946,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 2,
   "text": "GitLab trust = allowlisted issuer URL + JWKS + internal CA. GitLab's TLS certificate does not\nauthenticate jobs: the signed ID token does.\nHost names and ports are not fixed by the design.",
   "originalText": "GitLab trust = allowlisted issuer URL + JWKS + internal CA. GitLab's TLS certificate does not\nauthenticate jobs: the signed ID token does.\nHost names and ports are not fixed by the design.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  }
