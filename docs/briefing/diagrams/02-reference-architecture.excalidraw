   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 2,
   "text": "AI gateway (pass-through)\nVerifies STS token, route allowlist, size cap\nForwards only allowlisted client headers\nSets X-Proxied-Entity from token DN\nStreams. No body parsing or logging.\nmTLS cert: HSM or Vault if available",
   "originalText": "AI gateway (pass-through)\nVerifies STS token, route allowlist, size cap\nForwards only allowlisted client headers\nSets X-Proxied-Entity from token DN\nStreams. No body parsing or logging.\nmTLS cert: HSM or Vault if available",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "02-reference-architecture-31",
   "autoResize": true,
   "lineHeight": 1.25
  },
