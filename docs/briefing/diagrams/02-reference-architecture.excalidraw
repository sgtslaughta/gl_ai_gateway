   "link": null,
   "locked": false,
   "fontSize": 14,
   "fontFamily": 2,
   "text": "STS (RFC 8693-style exchange)\nVerifies signature, iss, aud, exp, nbf\nrunner_id on allowlist\nUnattended sources need ref_protected\nFork pipelines denied\nDN from directory lookup by email\nSigning key: HSM or Vault if available",
   "originalText": "STS (RFC 8693-style exchange)\nVerifies signature, iss, aud, exp, nbf\nrunner_id on allowlist\nUnattended sources need ref_protected\nFork pipelines denied\nDN from directory lookup by email\nSigning key: HSM or Vault if available",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "02-reference-architecture-29",
   "autoResize": true,
   "lineHeight": 1.25
  },
