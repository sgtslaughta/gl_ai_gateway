   "fontSize": 14,
   "fontFamily": 2,
   "text": "Ephemeral build pod\nprivileged = false\nallow_privilege_escalation = false\nautomount_service_account_token = false\nFixed non-root UID, run_as_non_root, allowed_users\nCPU and memory limits\nHOME and /builds on emptyDir\nRead-only root filesystem: try in pilot\nNo cache shared between projects",
   "originalText": "Ephemeral build pod\nprivileged = false\nallow_privilege_escalation = false\nautomount_service_account_token = false\nFixed non-root UID, run_as_non_root, allowed_users\nCPU and memory limits\nHOME and /builds on emptyDir\nRead-only root filesystem: try in pilot\nNo cache shared between projects",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "07-runner-and-image-hardening-5",
   "autoResize": true,
   "lineHeight": 1.25
  },
