   "roundness": null,
   "seed": 39595,
   "version": 1,
   "versionNonce": 523645,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 20,
   "fontFamily": 2,
   "text": "\u2022 No user keys or passwords on runners or in any new service\n\u2022 Every call attributed to user, project, commit, pipeline and job\n\u2022 Existing per-user permissions and rate limits still apply\n\u2022 One CI include for typical users; standard OpenAI and Anthropic\n   clients work\n\u2022 Version 1 only writes reports, so blast radius is small\n\u2022 Stateless services scale out, and prompts are not stored",
   "originalText": "\u2022 No user keys or passwords on runners or in any new service\n\u2022 Every call attributed to user, project, commit, pipeline and job\n\u2022 Existing per-user permissions and rate limits still apply\n\u2022 One CI include for typical users; standard OpenAI and Anthropic\n   clients work\n\u2022 Version 1 only writes reports, so blast radius is small\n\u2022 Stateless services scale out, and prompts are not stored",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
