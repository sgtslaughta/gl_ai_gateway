  {
   "id": "10-swot-overall-8",
   "type": "text",
   "x": 866,
   "y": 164,
   "width": 712.8000000000001,
   "height": 175.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
