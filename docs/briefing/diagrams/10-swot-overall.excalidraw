   "seed": 63352,
   "version": 1,
   "versionNonce": 837832,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 20,
   "fontFamily": 2,
   "text": "\u2022 Gives attribution, not cryptographic non-repudiation\n\u2022 Gateway certificate and STS key can each claim to be any user\n\u2022 No content screening: injection defense relies on limiting what\n   jobs can do\n\u2022 Audit shows who, when and where, but never what was sent\n\u2022 Identity follows who triggered the job, not who wrote the code\n\u2022 New HA services for the platform team to run and rotate keys for",
   "originalText": "\u2022 Gives attribution, not cryptographic non-repudiation\n\u2022 Gateway certificate and STS key can each claim to be any user\n\u2022 No content screening: injection defense relies on limiting what\n   jobs can do\n\u2022 Audit shows who, when and where, but never what was sent\n\u2022 Identity follows who triggered the job, not who wrote the code\n\u2022 New HA services for the platform team to run and rotate keys for",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
