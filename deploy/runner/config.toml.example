# Example only. Real values and the runner token come from the owner's config.
# Never commit the token. Review changes to this file as security policy changes.
concurrent = 2          # pilot: low

[[runners]]
  name = "ai-pilot"
  url = "https://gitlab.example.internal"
  token = "REPLACE_WITH_RUNNER_AUTH_TOKEN"   # from secret store, not the repo
  executor = "kubernetes"
  limit = 2             # pilot: low
  # "environment" belongs to the [[runners]] section. Writable HOME per the Runner docs
  # (matches the emptyDir mounted at /home/ai below).
  environment = ["HOME=/home/ai"]
  # No shared cache: [runners.cache] intentionally omitted.

  [runners.kubernetes]
    namespace = "ai-runners"
    privileged = false
    allow_privilege_escalation = false
    automount_service_account_token = false
    allowed_images = ["registry.example.internal/ai-hardened/*"]
    allowed_services = ["registry.example.internal/ai-hardened/*"]
    allowed_pull_policies = ["always"]
    allowed_users = ["10001"]   # matches image/Dockerfile user
    pull_policy = ["always"]
    helper_image = "registry.example.internal/ai-hardened/gitlab-runner-helper:x86_64-vRUNNER_VERSION"  # mirror; REPLACE RUNNER_VERSION with the exact runner version (helper must match)
    cpu_limit = "2"
    memory_limit = "4Gi"

    # Dedicated nodes (spec section 8). Placeholders: match your node labels/taints.
    [runners.kubernetes.node_selector]
      "example.internal/pool" = "ai-runners"
    [runners.kubernetes.node_tolerations]
      "example.internal/pool=ai-runners" = "NoSchedule"

    # Option names confirmed against GitLab Runner Kubernetes executor docs.
    # Pod-level seccomp_profile is supported (needs Kubernetes 1.19+), so PSA
    # restricted is met without falling back to baseline.
    # Namespace enforces PSA restricted, so containers must comply.
    [runners.kubernetes.pod_security_context]
      run_as_non_root = true
      run_as_user = 10001
      run_as_group = 10001
      fs_group = 10001
      [runners.kubernetes.pod_security_context.seccomp_profile]
        type = "RuntimeDefault"

    [runners.kubernetes.build_container_security_context]
      run_as_user = 10001
      run_as_group = 10001
      # read_only_root_filesystem is supported (runner docs, Kubernetes troubleshooting).
      # Left off here: jobs need writable /builds and HOME. Spec 8.2 says to try it in
      # the pilot; if enabled, mount emptyDir volumes for /builds and HOME as the docs show.
      # read_only_root_filesystem = true
      [runners.kubernetes.build_container_security_context.capabilities]
        drop = ["ALL"]

    [runners.kubernetes.init_permissions_container_security_context]
      run_as_user = 10001
      run_as_group = 10001
      read_only_root_filesystem = true
      [runners.kubernetes.init_permissions_container_security_context.capabilities]
        drop = ["ALL"]

    # UNTESTED: the helper as UID 10001 with a read-only root filesystem may fail
    # (it writes under /builds and its home). Test this first in the pilot and
    # relax read_only_root_filesystem for the helper only if the job cannot start.
    [runners.kubernetes.helper_container_security_context]
      run_as_user = 10001
      run_as_group = 10001
      read_only_root_filesystem = true
      [runners.kubernetes.helper_container_security_context.capabilities]
        drop = ["ALL"]

    # Jobs using `services:` need this too, or PSA restricted rejects the pod.
    [runners.kubernetes.service_container_security_context]
      run_as_user = 10001
      run_as_group = 10001
      read_only_root_filesystem = true
      [runners.kubernetes.service_container_security_context.capabilities]
        drop = ["ALL"]

    # image/Dockerfile sets HOME=/home/ai; give it a writable ephemeral volume.
    [[runners.kubernetes.volumes.empty_dir]]
      name = "home"
      mount_path = "/home/ai"
